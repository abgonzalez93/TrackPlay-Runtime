{
  "type": "module",
  "name": "@trackplay/runtime",
  "author": "Antonio Bueno Gonzalez",
  "version": "0.1.1",
  "private": false,
  "main": "./dist/index.js",
  "imports": {
    "#middlewares/*": "./dist/middlewares/*.js",
    "#routes/*": "./dist/routes/*.js",
    "#runtime/*": "./dist/runtime/*.js",
    "#types/*": "./dist/types/*.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "lint": "eslint src",
    "release": "pnpm build && rm -f trackplay-runtime-*.tgz && pnpm pack && pnpm publish --tag latest --no-git-checks"
  },
  "dependencies": {
    "@trackplay/core": "^0.5.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "packageManager": "pnpm@10.19.0"
}
