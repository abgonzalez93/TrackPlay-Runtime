{
  "type": "module",
  "name": "@trackplay/runtime",
  "author": "Antonio Bueno Gonzalez",
  "version": "0.2.0",
  "private": false,
  "main": "./dist/index.js",
  "imports": {
    "#constants/*": {
      "development": "./src/constants/*.ts",
      "default": "./dist/constants/*.js"
    },
    "#middlewares/*": {
      "development": "./src/middlewares/*.ts",
      "default": "./dist/middlewares/*.js"
    },
    "#routes/*": {
      "development": "./src/routes/*.ts",
      "default": "./dist/routes/*.js"
    },
    "#runtime/*": {
      "development": "./src/runtime/*.ts",
      "default": "./dist/runtime/*.js"
    },
    "#types/*": {
      "development": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "lint": "eslint src",
    "release": "pnpm build && rm -f trackplay-runtime-*.tgz && pnpm pack && pnpm publish --tag latest --no-git-checks"
  },
  "dependencies": {
    "@trackplay/core": "link:../trackplay-core",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "i18next-http-middleware": "^3.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "packageManager": "pnpm@10.28.2"
}
